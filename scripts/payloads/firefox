#!/usr/bin/bash
set -euo pipefail

version=158.0
bundle="/usr/lib/arkpkg/firefox-${version}.tar.xz"
version_root="${XDG_CACHE_HOME:-${HOME:-/root}/.cache}/arkpkg/firefox/${version}"
browser="${version_root}/firefox/firefox"
lock="${version_root}/.extract-lock"

if [[ ! -x "$browser" ]]; then
  mkdir -p "$version_root"
  lock_owned=0
  while [[ ! -x "$browser" ]]; do
    if mkdir "$lock" 2>/dev/null; then
      lock_owned=1
      break
    fi
    owner=
    if [[ -r "$lock/pid" ]]; then
      read -r owner < "$lock/pid" || true
    fi
    if [[ -z "$owner" ]]; then
      rmdir "$lock" 2>/dev/null || true
      sleep 1
      continue
    fi
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -rf -- "$lock"
      continue
    fi
    sleep 1
  done

