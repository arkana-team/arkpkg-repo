#!/usr/bin/bash
set -euo pipefail

version=158.0
bundle="/usr/lib/arkpkg/firefox-${version}.tar.xz"
version_root="${XDG_CACHE_HOME:-${HOME:-/root}/.cache}/arkpkg/firefox/${version}"
browser="${version_root}/firefox/firefox"
lock="${version_root}/.extract-lock"

if [[ ! -x "$browser" ]]; then
  mkdir -p "$version_root"
  lock_owned=0
  while [[ ! -x "$browser" ]]; do
    if mkdir "$lock" 2>/dev/null; then
      lock_owned=1
      break
    fi
    owner=
    if [[ -r "$lock/pid" ]]; then
      read -r owner < "$lock/pid" || true
    fi
    if [[ -z "$owner" ]]; then
      rmdir "$lock" 2>/dev/null || true
      sleep 1
      continue
    fi
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -rf -- "$lock"
      continue
    fi
    sleep 1
  done

  if (( lock_owned )); then
    temp_dir=
    cleanup() {
      if [[ -n "$temp_dir" ]]; then
        rm -rf -- "$temp_dir"
      fi
      rmdir "$lock" 2>/dev/null || true
    }
    printf '%s\n' "$$" > "$lock/pid"
    trap cleanup EXIT
    trap 'exit 1' HUP INT TERM
    if [[ ! -x "$browser" ]]; then
      temp_dir="$(mktemp -d "$version_root/.extract.XXXXXXXX")"
      tar -xJf "$bundle" -C "$temp_dir"
      mv -- "$temp_dir/firefox" "$version_root/firefox"
    fi
    cleanup
    trap - EXIT HUP INT TERM
  fi
fi

if [[ ! -x "$browser" ]]; then
  printf 'Firefox extraction did not complete; remove %s and try again.\n' "$lock" >&2
  exit 1
fi

