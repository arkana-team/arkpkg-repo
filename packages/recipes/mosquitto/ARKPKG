Name: mosquitto
Description: MQTT version 5.0/3.1.1/3.1 compatible message broker
Version: 2.0.21-1
Arch: x86_64
URL: https://mosquitto.org/
License: See /usr/share/doc/mosquitto/copyright
Maintainer: arkanaOS Team
Dependencies:
  libcjson1
  libdlt2
  libmosquitto1
  libwebsockets19t64
  libwrap-libs
  openssl-libs
  systemd-libs
Provides: mosquitto=/usr/sbin/mosquitto, mosquitto_ctrl=/usr/bin/mosquitto_ctrl, mosquitto_passwd=/usr/bin/mosquitto_passwd
