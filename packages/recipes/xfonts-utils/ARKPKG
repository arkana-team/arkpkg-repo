  mkfontscale
  xfonts-encodings
Provides: bdftopcf=/usr/bin/bdftopcf, update-fonts-alias=/usr/sbin/update-fonts-alias, update-fonts-dir=/usr/sbin/update-fonts-dir, update-fonts-scale=/usr/sbin/update-fonts-scale
